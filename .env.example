# ==============================================================================
# SIPAK-GURU Hub - Konfigurasi Lingkungan (.env.example)
# Salin file ini menjadi .env di komputer Anda: cp .env.example .env
# ==============================================================================

# Port Web Server (default: 3000)
PORT=3000

# Konfigurasi Koneksi Database MySQL (Standar bawaan XAMPP di Windows / macOS)
# Host MySQL lokal
DB_HOST="localhost"
# Port standar MySQL XAMPP
DB_PORT="3306"
# Username default XAMPP
DB_USER="root"
# Password default XAMPP (kosong)
DB_PASSWORD=""
# Nama database yang diimpor dari database.sql
DB_NAME="sipak_guru_db"

# Nonaktifkan HMR (Hot Module Replacement) jika tidak ingin live-reload aktif
DISABLE_HMR=false
