<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Handle OPTIONS CORS
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ $1 [R=200,L]

  # Direct all /api/ requests to api.php
  RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]

  # If requested physical file or folder exists, serve directly (assets, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise redirect all requests to index.html for Single Page Application (React)
  RewriteRule ^ index.html [L]
</IfModule>

# Security: Protect sensitive configuration files
<FilesMatch "^\.env|\.sql$">
  Order allow,deny
  Deny from all
</FilesMatch>
